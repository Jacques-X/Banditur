{
  "name": "banditur",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:transcribe": "./scripts/build-transcribe-sidecar.sh",
    "build:desktop": "npm run build && npm run build:transcribe",
    "build:local": "node scripts/build-local.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:app": "./scripts/build-updater-release.sh",
    "publish:update": "node scripts/publish-update.mjs",
    "smoke:meta": "node scripts/meta-smoke.mjs",
    "test": "node --test \"src/**/*.test.mjs\" \"backend/tests/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:py": "python3 sidecar/test_maltese.py && python3 sidecar/test_passage.py",
    "check": "npm test && npm run test:py && npm run build"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/supabase-js": "^2.104.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.2",
    "vite": "^6"
  }
