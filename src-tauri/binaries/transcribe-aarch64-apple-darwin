#!/usr/bin/env bash
# Transcribe sidecar launcher.
#
# Release build: runs the PyInstaller --onedir bundle from Contents/Resources/
#   so MLX can properly initialise the Metal GPU backend (--onefile extracts
#   to /tmp which breaks Metal).
#
# Dev build: walks up from cwd to the project root and invokes transcribe.py
#   via the venv Python.

# ── Release: onedir bundle in Contents/Resources/ ────────────────────────────
MACOS_DIR="$(cd "$(dirname "$0")" && pwd)"
RESOURCES_DIR="$(dirname "$MACOS_DIR")/Resources/transcribe-bundle"
BUNDLE_BIN="$RESOURCES_DIR/transcribe-bundle"

if [ -f "$BUNDLE_BIN" ]; then
    exec "$BUNDLE_BIN" "$@"
fi

# ── Dev: walk up from cwd to find the project root ───────────────────────────
echo "[wrapper] pwd: $(pwd)" >&2

SEARCH="$(pwd)"
PROJECT_ROOT=""
for _ in 1 2 3 4 5 6; do
    if [ -f "$SEARCH/sidecar/transcribe.py" ]; then
        PROJECT_ROOT="$SEARCH"
        break
    fi
    PARENT="$(dirname "$SEARCH")"
    [ "$PARENT" = "$SEARCH" ] && break
    SEARCH="$PARENT"
done

if [ -z "$PROJECT_ROOT" ]; then
    echo "[wrapper] ERROR: could not find project root" >&2
    exit 2
fi

PYTHON="$PROJECT_ROOT/venv/bin/python3"
[ -f "$PYTHON" ] || PYTHON="$PROJECT_ROOT/venv/bin/python"
[ -f "$PYTHON" ] || PYTHON="$(command -v python3 || echo python3)"

exec "$PYTHON" "$PROJECT_ROOT/sidecar/transcribe.py" "$@"
