#!/usr/bin/env bash
# Dev wrapper — invokes ytmp3.py via the project venv.

SEARCH="$(pwd)"
PROJECT_ROOT=""
for _ in 1 2 3 4 5 6; do
    if [ -f "$SEARCH/sidecar/ytmp3.py" ]; then
        PROJECT_ROOT="$SEARCH"
        break
    fi
    PARENT="$(dirname "$SEARCH")"
    [ "$PARENT" = "$SEARCH" ] && break
    SEARCH="$PARENT"
done

if [ -z "$PROJECT_ROOT" ]; then
    echo "[ytmp3] ERROR: could not find project root" >&2
    exit 2
fi

PYTHON="$PROJECT_ROOT/sidecar/venv/bin/python3"
[ -f "$PYTHON" ] || PYTHON="$PROJECT_ROOT/sidecar/venv/bin/python"
[ -f "$PYTHON" ] || PYTHON="$PROJECT_ROOT/venv/bin/python3"
[ -f "$PYTHON" ] || PYTHON="$PROJECT_ROOT/venv/bin/python"
[ -f "$PYTHON" ] || PYTHON="$(command -v python3 || echo python3)"

exec "$PYTHON" "$PROJECT_ROOT/sidecar/ytmp3.py" "$@"
